{
  "name": "torah-scroll",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --skip-generate && npm run db:seed",
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "test:calendar": "tsx scripts/check-calendar.mts",
    "test:e2e": "tsx scripts/e2e.mts",
    "dev:lan": "next dev -H 0.0.0.0",
    "start:lan": "next start -H 0.0.0.0",
    "test:sefaria": "tsx scripts/check-sefaria.mts",
    "sync:texts": "tsx scripts/sync-texts.mts",
    "test:sources": "tsx scripts/check-sources.mts",
    "sync:sources": "tsx scripts/sync-sources.mts"
  },
  "dependencies": {
    "@hebcal/core": "^6.9.2",
    "@hebcal/learning": "^6.11.3",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "fast-xml-parser": "^5.11.1",
    "jose": "^5.9.6",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
